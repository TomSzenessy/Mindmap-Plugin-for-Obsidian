{
  "name": "tomindmap",
  "version": "0.13.6",
  "private": true,
  "description": "Keyboard and touch mind mapping for Obsidian Canvas",
  "scripts": {
    "build": "npm run build:vector-pdf && node scripts/inline-runtime-modules.js",
    "build:vector-pdf": "esbuild lib/vector-pdf-entry.js --bundle --platform=browser --format=cjs --target=chrome120 --outfile=lib/vector-pdf-bundle.js",
    "build:vector-pdf:check": "node scripts/verify-vector-pdf.js --check",
    "verify:vector-pdf": "node scripts/verify-vector-pdf.js",
    "source:extract": "node scripts/extract-main-source.js",
    "build:check": "node scripts/inline-runtime-modules.js --check",
    "test": "node --test tests/*.test.js",
    "check": "npm run build:check && npm run build:vector-pdf:check && npm test && node --check main.js && node test-load.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.12.0"
  }
}
